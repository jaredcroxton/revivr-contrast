# Revivr: environment variables
# Copy to .env for local work, and add the same keys in Vercel under
# Project Settings > Environment Variables. Never commit the real .env.

# ---------------------------------------------------------------
# Resend: the enquiry form at /#enquire
# ---------------------------------------------------------------
# 1. Create an account at resend.com
# 2. Verify revivr.com.au as a sending domain (Domains > Add Domain, then add
#    the DNS records it gives you)
# 3. Create an API key (API Keys > Create)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The address enquiries are sent FROM. Must be on the verified domain.
ENQUIRY_FROM="Revivr <camps@revivr.com.au>"

# The inbox that receives enquiries. Comma-separate for more than one.
ENQUIRY_TO=info@revivr.com.au

# ---------------------------------------------------------------
# Stripe: the coaching packages at /#pricing
# ---------------------------------------------------------------
# 1. Create an account at stripe.com
# 2. Developers > API keys > copy the secret key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# 3. Create three Products in Stripe, then paste each one's PRICE id here.
#    The price id starts with "price_", not "prod_".
#    Essential: $99 AUD recurring weekly
#    Session:   $75 AUD one off
#    Business:  $99 AUD recurring monthly
STRIPE_PRICE_ESSENTIAL=price_xxxxxxxxxxxxx
STRIPE_PRICE_SESSION=price_xxxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxxx

# 4. Developers > Webhooks > add an endpoint pointing at
#    https://YOUR-DOMAIN/api/webhook and subscribe to
#    checkout.session.completed. Copy the signing secret here.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------
# Site
# ---------------------------------------------------------------
# Used to build the Stripe success and cancel return URLs.
# Leave unset on Vercel and it falls back to the request host.
SITE_URL=https://revivr.com.au
